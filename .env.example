# ── Social Pilot admin ───────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Threads live publishing. Пока достаточно long-lived access token.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_BASE=https://graph.threads.net/v1.0
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ── AI бриф-чат ──────────────────────────────────────────────
# Обязательно: ключ Anthropic API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# ── Доставка заявки (опционально, можно включить любой из каналов) ──

# Telegram-уведомление Сергею о новой заявке.
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather
# TELEGRAM_CHAT_ID   — твой chat id (узнать у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email-копия заявки через Resend (resend.com → API Keys).
# Без своего домена работает onboarding@resend.dev и шлёт только на твою почту.
RESEND_API_KEY=
# RESEND_FROM="Заявки <noreply@твойдомен.ru>"
